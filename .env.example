# Most of the values below can now be set in the app under Settings — a stored
# setting wins over the environment. Keep using this file for bootstrap values
# (CUF_SECRET_KEY, CUF_AUTH_SECRET, CUF_DB_PATH) and for locked-down deploys.
# archfleet configuration — copy to .env.local (Next reads it) and fill in.

# --- Database (shared Perceo SQLite) ---
CUF_DB_PATH=./data/fleet.db

# --- Secrets encryption (required to store secrets) ---
# Any string; used to derive the AES-256-GCM key. Keep OUT of the database/repo.
CUF_SECRET_KEY=

# --- VM fleet ---
# Single VM shorthand (bind one libvirt domain):
CUF_GOLDEN_DOMAIN=cuf-golden
CUF_SSH_KEY=./virt/.state/cuf_id
CUF_GUEST_HOST=127.0.0.1
# For Docker bridge deployment, prepare/build VMs with HOST_BIND set to the
# Docker host-gateway IP and FLEET_HOST=host.docker.internal.
# HOST_BIND=127.0.0.1
# FLEET_HOST=
CUF_GUEST_SSH_PORT=10022
CUF_GUEST_RDP_PORT=13389
AGENT_USER=agent
CUF_LIBVIRT_URI=qemu:///session
# Optional browser-based XRDP takeover through Apache Guacamole + QuickConnect.
# When unset, the dashboard falls back to downloading a .rdp file.
# CUF_GUACAMOLE_URL=http://127.0.0.1:8080/guacamole
# CUF_GUACAMOLE_PUBLIC_URL=http://127.0.0.1:8080/guacamole
# CUF_GUACAMOLE_USERNAME=guacadmin
# CUF_GUACAMOLE_PASSWORD=
# GUACAMOLE_ADMIN_PASSWORD=
# GUACAMOLE_BIND_HOST=127.0.0.1
# GUACAMOLE_POSTGRES_PASSWORD=
# Or a multi-VM fleet (overrides/augments the shorthand):
# CUF_FLEET_JSON=[{"domain":"cuf-golden","sshPort":10022,"rdpPort":13389},{"domain":"cuf-2","sshPort":10122,"rdpPort":13489}]
# Profile clones created by `npm run vm:prepare-profile -- --profile bank --clones 2`.
# Refresh with `npm run vm:update-profile -- --profile bank --clones 2` and verify
# with `npm run vm:recover-profile -- --profile bank`.
# include a `profile` label so workflows can target requiredLabels=["profile:bank"].
# CUF_FLEET_JSON_FILE=./virt/.state/bank.fleet.json
# CUF_FLEET_JSON=[{"domain":"cuf-bank-1","sshPort":11022,"rdpPort":14389,"snapshot":"golden-warm","profile":"bank"}]

# --- Agent models ---
# mock = run the full stack without any model (demo/integration). Unset for real runs.
CUF_AGENT_BACKEND=mock
OPENROUTER_API_KEY=
CUF_PLANNER_MODEL=anthropic/claude-sonnet-4-6
CUF_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CUF_GROUNDING_BASE_URL=http://127.0.0.1:8080/v1

# --- Runtime knobs ---
CUF_WORKER_INTERVAL_MS=5000      # queue worker poll interval
CUF_TICK_INTERVAL_MS=60000       # schedule-trigger tick interval
CUF_RUN_BACKOFF_MS=30000         # retry delay when no VM is available
CUF_ARTIFACT_DIR=./data/artifacts
# CUF_ALLOW_SHELL=1              # enable shell_task nodes (runs controller commands)
# CUF_DISABLE_TICK=1            # defer schedule ticks to an external cron
